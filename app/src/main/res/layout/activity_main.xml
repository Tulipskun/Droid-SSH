<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:subtitle="เซิร์ฟเวอร์ SSH บนมือถือ" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- สถานะ: contained unit (filled card = tonal containment) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="สถานะเซิร์ฟเวอร์"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="STOPPED"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="คัดลอกคำสั่งเชื่อมต่อ" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SectionHeader"
                android:text="การเชื่อมต่อ" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUser"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ชื่อผู้ใช้"
                app:helperText="ใช้ตอนล็อกอินผ่าน SSH">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPass"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="รหัสผ่านใหม่"
                app:endIconMode="password_toggle"
                app:helperText="เว้นว่างไว้หากไม่ต้องการเปลี่ยน">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="โหมดเซิร์ฟเวอร์" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="โหมดรูท" />

            <TextView
                style="@style/SectionHint"
                android:text="เปิด: ใช้พอร์ต 22 กับเชลล์สิทธิ์รูท · ปิด: ใช้พอร์ต 2222 — มีผลครั้งถัดไปที่เปิด SSH" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="เริ่มอัตโนมัติและทำงานค้างไว้" />

            <TextView
                style="@style/SectionHint"
                android:text="เปิดเซิร์ฟเวอร์เองหลังเปิดเครื่อง และเปิดใหม่ให้อัตโนมัติหากถูกปิด" />

            <TextView
                style="@style/SectionHeader"
                android:text="คีย์สำหรับล็อกอิน" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swKeyAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="อนุญาตให้ล็อกอินด้วย public key" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="authorized_keys"
                app:helperText="วางคีย์ ssh-rsa / ecdsa / ed25519 ทีละบรรทัด">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAuthKeys"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primary action = filled, secondary = tonal/outlined (ห้ามมี filled 2 ปุ่มติดกัน) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="เปิด SSH" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="บันทึกการตั้งค่า" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="หยุด SSH" />

            <TextView
                style="@style/SectionHeader"
                android:text="ระบบ" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยกเว้นการประหยัดแบต (กันแอปถูกปิด)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStorage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ขอสิทธิ์เข้าถึงไฟล์ (สำหรับ SFTP)" />

            <TextView
                style="@style/SectionHeader"
                android:text="Debian guest (apt)" />

            <TextView
                android:id="@+id/tvGuest"
                style="@style/SectionHint"
                android:text="ยังไม่ติดตั้ง" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuest"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ติดตั้ง Debian guest" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
